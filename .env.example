# ==============================================================================
# Zeinity Executive Report Web App - Environment Configuration Example
# ==============================================================================
# Salin file ini menjadi `.env` di folder root project untuk konfigurasi lokal:
#   cp .env.example .env
#
# Seluruh variabel dengan prefiks `VITE_` dapat diakses oleh browser melalui
# `import.meta.env` saat runtime atau build Vite.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Sync (Database & Realtime Subscriptions) - OPSIONAL
# ------------------------------------------------------------------------------
# URL project Supabase dan Public Anonymous (Anon) Key.
# Jika kedua variabel ini dikosongkan atau diset 'placeholder', aplikasi akan
# berjalan secara otomatis dalam Safe Offline Mode (menggunakan browser localStorage
# dan in-memory cache) tanpa mengirim network request ke server Supabase.
#
# Dapatkan nilai ini dari: Dashboard Supabase -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Key (Default Fallback) - OPSIONAL
# ------------------------------------------------------------------------------
# Kunci API default untuk inferensi AI Google Gemini (Flash / Pro).
# 
# CATATAN KEAMANAN:
# - Variabel VITE_* yang didefinisikan pada file .env ini akan disertakan dalam
#   build bundle JavaScript sisi klien.
# - Sebagai alternatif yang lebih aman, Anda dapat mengosongkan variabel ini di
#   .env dan memasukkan API Key secara langsung melalui halaman "Settings" di aplikasi.
# - Kunci API yang dimasukkan via antarmuka Settings akan diisolasi secara aman di
#   penyimpanan lokal browser (localStorage) dan tidak pernah dikirim ke tabel publik.
#
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. 9Router AI Gateway - Remote Tunnel (Untuk Deployment Vercel / Netlify) - OPSIONAL
# ------------------------------------------------------------------------------
# Jika web app ini di-deploy ke Vercel / Netlify / Cloudflare Pages agar bisa
# dibuka di mana saja di luar komputer lokal:
# 1. Pastikan Tunnel di 9Router aktif (via terminal atau menu Settings 9Router).
# 2. Gunakan endpoint publik 9Router (direkomendasikan: https://<id>.abc-tunnel.us/v1
#    karena memiliki dukungan CORS otomatis untuk browser).
# 3. Masukkan 9Router Bearer API Key Anda (dari Dashboard 9Router -> API Keys).
# ------------------------------------------------------------------------------
# Endpoint publik resmi 9Router aktif saat ini (CORS-safe untuk browser web):
VITE_CUSTOM_GATEWAY_ENDPOINT=https://rje2m9z.abc-tunnel.us/v1
# Alternatif Direct Cloudflare Tunnel:
# VITE_CUSTOM_GATEWAY_ENDPOINT=https://watt-membrane-beds-customise.trycloudflare.com/v1
VITE_CUSTOM_GATEWAY_API_KEY=sk-aae08e472832982c-ocd8hb-aff3c45d
